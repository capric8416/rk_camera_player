[binaries]
c = 'zig-cc.cmd'
cpp = 'zig-c++.cmd'
ar = 'zig-ar.cmd'
strip = 'zig-strip.cmd'
ranlib = 'zig-ranlib.cmd'
libtool = 'zig-libtool.cmd'
pkg-config = 'pkgconf'
cmake = 'cmake'

[built-in options]
c_args = []
cpp_args = ['-fpermissive']
c_link_args = []
cpp_link_args = []

[properties]
sys_root = ''

[host_machine]
system = 'linux'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'
