[binaries]
c = 'zig-cc'
cpp = 'zig-c++'
ar = 'zig-ar'
strip = 'zig-strip'
ranlib = 'zig-ranlib'
libtool = 'zig-libtool'
pkg-config = 'pkgconf'
cmake = 'cmake'

[built-in options]
c_args = []
cpp_args = ['-fpermissive']
c_link_args = []
cpp_link_args = []

[properties]
sys_root = ''

[host_machine]
system = 'linux'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'
