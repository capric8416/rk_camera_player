prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include/qt5


Name: Qt5 OpenGL
Description: Qt OpenGL module
Version: 5.15.18


Libs: "-L${libdir}" -lQt5OpenGL "-L${prefix}/lib" "-L${prefix}/lib/manual-link" ${prefix}/lib/libQt5Widgets.so "-L${prefix}/lib/pkgconfig/../../lib" ${prefix}/lib/libQt5Gui.so -lharfbuzz -pthread -lstdc++ -lfreetype -lpng16 -lz ${prefix}/lib/libQt5Core.so -lm -lpcre2-16 ${prefix}/lib/libpng16.so ${prefix}/lib/libz.so -lpthread ${prefix}/lib/libpng16.so ${prefix}/lib/libz.so
Requires: Qt5Core Qt5Gui Qt5Widgets
Cflags: -DQT_OPENGL_LIB "-I${includedir}/QtOpenGL" "-I${includedir}"
