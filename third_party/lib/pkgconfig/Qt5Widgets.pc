prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include/qt5


Name: Qt5 Widgets
Description: Qt Widgets module
Version: 5.15.18


Libs: "-L${libdir}" -lQt5Widgets "-L${prefix}/lib" ${prefix}/lib/libQt5Gui.so "-L${prefix}/lib/pkgconfig/../../lib" -lharfbuzz -pthread -lstdc++ -lfreetype -lpng16 -lz ${prefix}/lib/libQt5Core.so -lm -lpcre2-16 ${prefix}/lib/libpng16.so ${prefix}/lib/libz.so -lpthread ${prefix}/lib/libpng16.so ${prefix}/lib/libz.so
Requires: Qt5Core Qt5Gui
Cflags: -DQT_WIDGETS_LIB "-I${includedir}/QtWidgets" "-I${includedir}"
