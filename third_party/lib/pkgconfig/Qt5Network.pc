prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include/qt5


Name: Qt5 Network
Description: Qt Network module
Version: 5.15.18


Libs: "-L${libdir}" -lQt5Network "-L${prefix}/lib" "-L${prefix}/lib/manual-link" ${prefix}/lib/libQt5Core.so -lm "-L${prefix}/lib/pkgconfig/../../lib" -lpcre2-16 ${prefix}/lib/libpng16.so ${prefix}/lib/libz.so -lpthread ${prefix}/lib/libz.so ${prefix}/lib/libssl.so ${prefix}/lib/libcrypto.so -ldl -lpthread ${prefix}/lib/libpng16.so ${prefix}/lib/libz.so
Requires: Qt5Core
Cflags: -DQT_NETWORK_LIB "-I${includedir}/QtNetwork" "-I${includedir}"
